[Unit]
Description=LXBoot kiosk UI
After=lxbootd.service
Requires=lxbootd.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=LXBOOT_PREFIX=/var/lib/lxboot
Environment=LXBOOT_SOCK=/run/lxboot/lxbootd.sock
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/usr/bin/lxboot-ui
Restart=on-failure
RestartSec=1
StandardInput=tty
TTYPath=/dev/tty1

[Install]
WantedBy=graphical.target
